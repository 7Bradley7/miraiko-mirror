# Miraiko environment variables
#
# 1. Copy this file to `.env.local`: cp .env.example .env.local
# 2. Fill in the values locally. `.env.local` is ignored by Git.
# 3. In production and preview, values are set in Vercel
#    (Project Settings → Environment Variables), never in the repository.
#
# Rules:
# - No real value in this file: only names and dummy examples.
# - Only variables prefixed with NEXT_PUBLIC_ are sent to the browser.
#   A secret key must therefore never use that prefix.
# - The CI secret scan (Gitleaks) blocks any PR that contains a key.

# --- Site -------------------------------------------------------------------

# Public URL of the site (absolute links, Open Graph metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (MRK-14: PostgreSQL + Prisma) ---------------------------------

# Neon project "miraiko" (Frankfurt). In the Neon console: Connect → copy both strings.
# Pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL=
# Direct connection (no "-pooler"), used by the Prisma CLI for migrations and seeding.
DATABASE_URL_UNPOOLED=
# Optional: empty database used by `prisma migrate dev` to detect schema drift.
# SHADOW_DATABASE_URL=

# --- Authentication (MRK-17, Better Auth) -----------------------------------

# Secret used to sign sessions and tokens. Generate one with: openssl rand -base64 32
# Use a different value in each environment (local, Preview, Production).
AUTH_SECRET=

# --- AniList (MRK-32: link a Miraiko account to AniList) --------------------

# API client from https://anilist.co/settings/developer. Locally, use the "Miraiko (dev)"
# client, whose redirect URL is http://localhost:3000/api/auth/callback/anilist.
# Production and Preview use the "Miraiko" client (set in Vercel).
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Shared by Production and Preview only (set in Vercel): lets previews link AniList
# through production, since AniList accepts a single redirect URL. Not needed locally.
# OAUTH_PROXY_SECRET=

# --- Emails (verification links) --------------------------------------------

# Resend API key (resend.com → API Keys, "Sending access"). Optional in development:
# without it, emails are printed in the server logs instead of being sent.
RESEND_API_KEY=
# Optional sender. Defaults to Resend's test sender until miraiko.fr is verified (MRK-78).
# EMAIL_FROM="Miraiko <hello@miraiko.fr>"
